{
  "useCSRFProtection": true,
  "security": {
    "referrerPolicy": "same-origin",
    "hsts": {
      "maxAge": 31536000,
      "includeSubDomains": true,
      "preload": true
    }
  },
  "secrets": {
    "apim": {
      "APP_INSIGHTS_CONNECTION_STRING": ""
    }
  },
  "analytics": {
    "gtmContainerId": ""
  },
  "dynatrace": {
    "jstagKey": "default",
    "jstags": {
      "default": "",
      "aat": "",
      "demo": "",
      "ithc": "",
      "perftest": "",
      "prod": ""
    }
  },
  "backend": {
    "url": "http://localhost:8080",
    "path": "/"
  }
}
