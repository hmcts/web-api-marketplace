#!groovy

properties([
// H allow predefined but random minute see https://en.wikipedia.org/wiki/Cron#Non-standard_characters
pipelineTriggers([cron('H 07 * * 1-5')])
])

@Library("Infrastructure@2.4.8")

def type = "nodejs"
def product = "amp"
def component = "marketplace-web"

withNightlyPipeline(type, product, component) {
  // Fortify on Demand, through the library's own runner. The vault holds the FoD credentials;
  // the library's default, amp-aat, does not exist
  enableFortifyScan('amp-marketplace-aat')
}
