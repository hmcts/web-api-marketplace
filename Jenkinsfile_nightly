#!groovy

properties([
// H allow predefined but random minute see https://en.wikipedia.org/wiki/Cron#Non-standard_characters
pipelineTriggers([cron('H 07 * * 1-5')]),
parameters([
  // The long-lived AAT release. The staging release only exists while a master build deploys
  string(name: 'URL_TO_TEST', defaultValue: 'https://amp-marketplace-web.aat.platform.hmcts.net', description: 'The URL you want to run these tests against'),
])
])

@Library("Infrastructure@2.13.6")

def type = "nodejs"
def product = "amp"
def component = "marketplace-web"

def yarnBuilder = new uk.gov.hmcts.contino.YarnBuilder(this)

// The signed-in journeys sign in as the Entra test accounts, as the master build's AAT stage does
def secrets = [
  'kvspsextid${env}': [
    secret('entra-amp-user-amp-functional-user-at-hmctsextstg-onmicrosoft-com', 'AMP_TEST_USER_PASSWORD'),
    secret('entra-amp-user-amp-functional-admin-at-hmctsextstg-onmicrosoft-com', 'AMP_TEST_ADMIN_PASSWORD'),
  ]
]

static LinkedHashMap<String, Object> secret(String secretName, String envVar) {
  [$class     : 'AzureKeyVaultSecret',
   secretType : 'Secret',
   name       : secretName,
   version    : '',
   envVariable: envVar
  ]
}

withNightlyPipeline(type, product, component) {
  env.TEST_URL = params.URL_TO_TEST

  // AAT runs the newest promoted image of both web and service, so the smoke set run here catches
  // a change to either breaking the other, without the service knowing anything about web
  enableE2eTest()
  before('E2eTest') {
    yarnBuilder.yarn('playwright install chrome')
  }

  // Every functional test and accessibility audit in all six browsers. Master builds run Edge and
  // Chrome only, with the accessibility audits in Chrome
  env.PLAYWRIGHT_WORKERS = 4
  env.PLAYWRIGHT_REPORTERS = 'list,odhin'
  env.PLAYWRIGHT_VIDEO_MODE = 'retain-on-failure'
  env.AMP_TEST_USER_EMAIL = 'amp-functional-user@hmctsextstg.onmicrosoft.com'
  env.AMP_TEST_ADMIN_EMAIL = 'amp-functional-admin@hmctsextstg.onmicrosoft.com'
  loadVaultSecrets(secrets)
  enableFullFunctionalTest(45)
  before('fullFunctionalTest') {
    yarnBuilder.yarn('playwright install')
  }
  afterAlways('fullFunctionalTest') {
    publishHTML target: [
      allowMissing          : true,
      alwaysLinkToLastBuild : true,
      keepAll               : true,
      reportDir             : 'test-results',
      reportFiles           : 'odhin-report/index.html',
      reportName            : 'Full Functional Test Report',
    ]
    publishHTML target: [
      allowMissing          : true,
      alwaysLinkToLastBuild : true,
      keepAll               : true,
      reportDir             : 'test-results/accessibility-report',
      reportFiles           : 'index.html',
      reportName            : 'Accessibility Test Report',
    ]
  }

  // The app's own cookies, added to the scan's ignore list. Set here because the library does not
  // pass enableSecurityScan's cookieIgnoreList on to the scan script
  env.CUSTOM_COOKIES = 'amp-cookie-preferences,connect.sid'
  // ZAP skips an excluded URL only when its entry is enabled. The catalogue pages scanned are
  // those of the APIs going to production, SLC and RCC
  enableSecurityScan(
    urlExclusions: "-config globalexcludeurl.url_list.url\\(1\\).regex='^https?:\\/\\/.*\\/(sign-in|sign-out|auth\\/callback).*\$' " +
      "-config globalexcludeurl.url_list.url\\(1\\).enabled=true " +
      "-config globalexcludeurl.url_list.url\\(2\\).regex='^https?:\\/\\/.*\\/api-catalogue\\/(?!(slc|rcc)\$).+\$' " +
      "-config globalexcludeurl.url_list.url\\(2\\).enabled=true"
  )
}
