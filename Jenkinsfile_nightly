#!groovy

properties([
// H allow predefined but random minute see https://en.wikipedia.org/wiki/Cron#Non-standard_characters
pipelineTriggers([cron('H 07 * * 1-5')]),
parameters([
  string(name: 'URL_TO_TEST', defaultValue: 'https://amp-marketplace-web.aat.platform.hmcts.net', description: 'The URL you want to run these tests against'),
])
])

@Library("Infrastructure@2.13.4")

def type = "nodejs"
def product = "amp"
def component = "marketplace-web"

withNightlyPipeline(type, product, component) {
  env.TEST_URL = params.URL_TO_TEST
  // The app's own cookies, added to the scan's ignore list. Set here because the library does not
  // pass enableSecurityScan's cookieIgnoreList on to the scan script
  env.CUSTOM_COOKIES = 'amp-cookie-preferences,connect.sid,_csrf,i18next'
  enableSecurityScan(
    urlExclusions: "-config globalexcludeurl.url_list.url\\(1\\).regex='^https?:\\/\\/.*\\/(sign-in|sign-out|auth\\/callback).*\$'"
  )
}
