#!groovy
@Library('Infrastructure@2.13.6') _

properties([
    parameters([
        choice(name: 'ENVIRONMENT', defaultValue: 'sandbox', choices: 'sandbox', description: 'Environment to deploy infrastructure to'),
    ])
])

withParameterizedPipeline('nodejs', 'amp', 'marketplace-web', params.ENVIRONMENT, 'sandbox') {
  // AMP sandbox is a long-lived environment, so keep its infrastructure out of the sandbox cleardown.
  // The expiresAfter tag is only applied in sandbox.
  // https://hmcts.github.io/cloud-native-platform/standards/environments/sandbox-cleardown.html
  expires("3000-01-01")
}
