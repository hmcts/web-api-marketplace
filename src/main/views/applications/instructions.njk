{#- How to use this application's credentials with one API (i), as curl commands: the token request, then the API's own calls and its test scenarios. -#}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{{ govukSummaryList({
  rows: [
    { key: { text: "Publisher ID (scope)" }, value: { html: '<span class="apim-credential" id="publisher-id-' + i.apiName + '">' + (i.token.publisherId | escape) + '</span>' } }
  ]
}) }}

<h3 class="govuk-heading-s">Get an access token</h3>
<p class="govuk-body">Request a token from Microsoft Entra ID with the OAuth 2.0 client credentials flow:</p>
<pre class="apim-code" id="token-request-{{ i.apiName }}"><code>curl --request POST \
  --url {{ i.token.url }} \
  --header 'Content-Type: application/x-www-form-urlencoded' \
  --data grant_type=client_credentials \
  --data client_id={{ i.token.clientId }} \
  --data 'client_secret={{ i.token.clientSecret }}' \
  --data scope={{ i.token.scope }}</code></pre>

{% for call in i.calls %}
  <h3 class="govuk-heading-s">{{ call.title }}</h3>
  {% if loop.first %}<p class="govuk-body">Send the access token with each request:</p>{% endif %}
  <pre class="apim-code" id="call-request-{{ i.apiName }}-{{ loop.index }}"><code>curl --request GET \
  --url {{ call.url }} \
  --header 'Accept: application/json' \
  --header 'Authorization: Bearer &lt;token&gt;' \
  --header 'Ocp-Apim-Subscription-Key: &lt;apim_subscription_key&gt;'</code></pre>
{% endfor %}

{% if i.scenariosUrl %}
  {% if i.placeholders.length %}
    <h3 class="govuk-heading-s">Find a {{ i.placeholders | join(" and ") }} to try</h3>
    <p class="govuk-body">List the test scenarios to get {{ "a " + i.placeholders[0] if i.placeholders.length == 1 else "values" }} to use in the {{ "request" if i.calls.length == 1 else "requests" }} above:</p>
  {% else %}
    <h3 class="govuk-heading-s">Try the test scenarios</h3>
    <p class="govuk-body">List the requests you can try:</p>
  {% endif %}
  <pre class="apim-code" id="scenarios-request-{{ i.apiName }}"><code>curl --request GET \
  --url {{ i.scenariosUrl }} \
  --header 'Accept: application/json' \
  --header 'Ocp-Apim-Subscription-Key: &lt;apim_subscription_key&gt;'</code></pre>
{% endif %}
