{% extends "template.njk" %}

{% set pageTitle = "Getting started with our APIs - HMCTS API Marketplace - GOV.UK" %}
{% set section = "get-started" %}
{% set breadcrumbs = [{ text: "Home", href: "/" }] %}

{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <h1 class="govuk-heading-xl">Getting started with our APIs</h1>

    <p class="govuk-body-l">
      Learn about what APIs we offer and how you can connect to them.
    </p>

    {{ govukInsetText({
      html: 'If you own an API and want to list it on the marketplace, read the
             <a class="govuk-link" href="/documentation/producer-standards#producer-onboarding">producer
             onboarding steps</a> instead.'
    }) }}

    <h2 class="govuk-heading-l" id="steps">Steps to get connected</h2>

    <h3 class="govuk-heading-m">1. Learn about our APIs</h3>

    <p class="govuk-body">
      Before you design your software, read the
      <a class="govuk-link" href="/documentation/consumer-onboarding">consumer onboarding steps</a> and check the
      <a class="govuk-link" href="/documentation/consumer-guidance">consumer guidance</a> for rate
      limits and error handling. Review the
      <a class="govuk-link" href="/documentation/data-governance">data governance standards</a> for the data
      classification and legal obligations that apply. All our APIs use OAuth 2.0 with JWT bearer tokens.
    </p>

    <h3 class="govuk-heading-m">2. Confirm your use case</h3>

    <p class="govuk-body">
      Before you go any further, confirm that you have a valid use case for the APIs you want to use.
      Production access is only approved for a valid use case, so be ready to explain yours when you
      apply.
    </p>

    <h3 class="govuk-heading-m">3. Test the APIs</h3>

    <p class="govuk-body">
      You can test our APIs with dummy data before you ask for access to live data. To do this, you
      need to:
    </p>

    <ul class="govuk-list govuk-list--bullet">
      <li>browse the <a class="govuk-link" href="/api-catalogue">API catalogue</a> to find the APIs you
        want to test</li>
      <li><a class="govuk-link" href="/register">create a developer account</a>, or
        <a class="govuk-link" href="/sign-in">sign in</a> if you already have one</li>
      <li><a class="govuk-link" href="/account/applications/new">create an application</a> for Try it now,
        so you can test using dummy data</li>
      <li>choose the APIs you want to test</li>
      <li>get your Try it now credentials and keys, which are issued automatically with no review</li>
      <li>test your software with the APIs</li>
    </ul>

    <h3 class="govuk-heading-m">4. Apply for production access</h3>

    <p class="govuk-body">
      When you are ready to use live data, request production credentials for an application you have
      tested in Try it now.
    </p>

    <p class="govuk-body">
      Your request is reviewed by the HMCTS Data Access Panel. This is currently an offline process, so
      look out for emails requesting clarification, or confirming approval or rejection.
    </p>

    <p class="govuk-body">
      If your request is approved, the API Marketplace team will issue your production credentials and
      keys. You can then use them to call our APIs with live data.
    </p>

    <h2 class="govuk-heading-l" id="help">Get help and support</h2>

    <p class="govuk-body">
      If you have any issues, either during development or once your software is live, you can
      <a class="govuk-link" href="/help">contact the marketplace team</a>.
    </p>

    <p class="govuk-body">
      Read the <a class="govuk-link" href="/documentation/consumer-guidance">consumer guidance</a> for
      detailed information on using APIs responsibly, or the
      <a class="govuk-link" href="/documentation/data-governance">data governance standards</a> for your legal
      obligations.
    </p>

    {{ govukButton({
      text: "Browse the API catalogue",
      href: "/api-catalogue",
      isStartButton: true
    }) }}

  </div>
</div>

{% endblock %}
