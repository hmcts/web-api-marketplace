{% extends "template.njk" %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageTitle = api.title + " - API catalogue - HMCTS API Marketplace - GOV.UK" %}
{% set section = "catalogue" %}
{% set breadcrumbs = [
  { text: "Home", href: "/" },
  { text: "API catalogue", href: "/api-catalogue" }
] %}

{% block content %}

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <h1 class="govuk-heading-xl">{{ api.title }}</h1>

    {% if descriptionParagraphs.length %}
      <h2 class="govuk-heading-m">What does this API do?</h2>

      {% for paragraph in descriptionParagraphs %}
        <p class="govuk-body">{{ paragraph }}</p>
      {% endfor %}
    {% endif %}

    <h2 class="govuk-heading-m">Use this API</h2>

    <p class="govuk-body">
      Add this API to an application to try it out with dummy data. Your Try it now credentials, a
      subscription key, client ID and secret, are issued automatically with no review.
    </p>

    <p class="govuk-body">
      When you are ready to use live data, request production credentials for the application you
      have tested. Your production credentials request is reviewed by the HMCTS Data Access Team, and
      you will get an outcome within 5 working days of submitting it.
    </p>

    <p class="govuk-body">
      {% if not user %}
        You need a <a class="govuk-link" href="/sign-in?prompt=create">developer account</a> to create an application.
      {% endif %}
      Read the <a class="govuk-link" href="/documentation/consumer-guidance">consumer guidance</a> before you start.
      See <a class="govuk-link" href="/get-started#browse-the-catalogue">how browsing differs from Try it now</a>.
    </p>

    <div class="govuk-button-group">
      {{ govukButton({ text: "Add to a new application", href: "/account/applications/new", attributes: { id: "add-to-application" } }) }}
    </div>

    <h2 class="govuk-heading-m">About this API</h2>

    {% set aboutRows = [] %}
    {% for row in [
      { label: "Owning team", value: api.team },
      { label: "Platform", value: api.platform },
      { label: "Domain", value: api.domain },
      { label: "Short code", value: api.shortCode },
      { label: "Repository name", value: api.catalogueName }
    ] %}
      {% if row.value %}
        {% set aboutRows = (aboutRows.push({ key: { text: row.label }, value: { text: row.value } }), aboutRows) %}
      {% endif %}
    {% endfor %}
    {{ govukSummaryList({ rows: aboutRows, attributes: { id: "about-this-api" } }) }}

    {% if api.portalUrl or api.repoUrl %}
      <h2 class="govuk-heading-m">Documentation</h2>

      <ul class="govuk-list">
        {% if api.portalUrl %}
          <li><a class="govuk-link" href="{{ api.portalUrl }}" rel="noreferrer noopener" target="_blank">Read the API reference (opens in new tab)</a></li>
        {% endif %}
        {% if api.repoUrl %}
          <li><a class="govuk-link" href="{{ api.repoUrl }}" rel="noreferrer noopener" target="_blank">View the source repository on GitHub (opens in new tab)</a></li>
        {% endif %}
      </ul>
    {% endif %}

  </div>
</div>

{% endblock %}
