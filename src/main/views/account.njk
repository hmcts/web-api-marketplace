{% extends "template.njk" %}

{% set pageTitle = "Your account - HMCTS API Marketplace - GOV.UK" %}
{% set section = "account" %}
{% set hideBackLink = true %}

{% from "govuk/components/tabs/macro.njk" import govukTabs %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{% block content %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <h1 class="govuk-heading-xl">{{ heading }}</h1>

      {% set accountPanel %}
        {{ govukSummaryList({
          rows: [
            { key: { text: "Name" },       value: { text: user.firstName + " " + user.lastName } },
            { key: { text: "Email" },      value: { text: user.email } },
            { key: { text: organisation }, value: { text: user.orgName } }
          ]
        }) }}

        {# POST, so no link or prefetcher can sign the user out. #}
        <form method="post" action="/sign-out">
          {{ govukButton({ text: signOutButton, classes: "govuk-button--secondary", attributes: { id: "sign-out" } }) }}
        </form>
      {% endset %}

      {% set requestsPanel %}
        {% if deleted %}
          {{ govukNotificationBanner({
            type: "success",
            titleText: requests.deletedTitle,
            text: requests.deleted,
            attributes: { id: "request-deleted" }
          }) }}
        {% elif deleteFailed %}
          {{ govukNotificationBanner({
            titleText: requests.deleteFailedTitle,
            text: requests.deleteFailed,
            attributes: { id: "request-delete-failed" }
          }) }}
        {% endif %}

        <h2 class="govuk-heading-l">{{ requests.heading }}</h2>

        <p class="govuk-body">{{ requests.intro }}</p>

        {% if couldNotLoad %}
          <p class="govuk-body" id="requests-unavailable">{{ requests.unavailable }}</p>
        {% elif myRequests.length %}
          {% set rows = [] %}
          {% for request in myRequests %}
            {#
              POST, and the reference travels in the body rather than the URL, so nothing
              that merely follows a link can delete a request. The type goes with it
              because each kind is deleted from its own backend collection.
            #}
            {% set deleteCell %}
              <form method="post" action="/account/delete-request" class="apim-delete-request">
                <input type="hidden" name="reference" value="{{ request.reference }}">
                <input type="hidden" name="type" value="{{ request.type }}">
                {{ govukButton({
                  html: requests.deleteButton + '<span class="govuk-visually-hidden"> ' + request.reference + '</span>',
                  classes: "govuk-button--warning govuk-!-margin-bottom-0",
                  attributes: { id: "delete-" + loop.index }
                }) }}
              </form>
            {% endset %}

            {% set rows = (rows.push([
              { html: '<span class="apim-reference">' + request.reference + '</span>' },
              { text: requests.types[request.type] or request.type },
              { text: request.submittedOn },
              { text: request.status },
              { html: deleteCell }
            ]), rows) %}
          {% endfor %}

          {{ govukTable({
            caption: requests.tableCaption,
            captionClasses: "govuk-visually-hidden",
            head: [
              { text: requests.columnReference },
              { text: requests.columnType },
              { text: requests.columnSubmitted },
              { text: requests.columnStatus },
              { html: '<span class="govuk-visually-hidden">' + requests.columnAction + '</span>' }
            ],
            rows: rows
          }) }}
        {% else %}
          <p class="govuk-body" id="requests-empty">{{ requests.emptyHtml | safe }}</p>
        {% endif %}
      {% endset %}

      {{ govukTabs({
        items: [
          { label: heading,           id: "tab-account",  panel: { html: accountPanel } },
          { label: requests.tabLabel, id: "tab-requests", panel: { html: requestsPanel } }
        ]
      }) }}

    </div>
  </div>

{% endblock %}
