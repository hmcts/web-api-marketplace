{% from "govuk/components/button/macro.njk" import govukButton %}

{% extends "template.njk" %}

{#
  Sign in itself happens on Microsoft Entra's pages. This is what the user sees when they
  come back from Entra without being signed in, which is one of:

    cancelled    they chose not to sign in, or Entra refused
    expired      the sign in was not started from this browser, or took too long
    unavailable  Entra could not be reached to finish signing in
    rejected     what Entra sent back could not be trusted

  The first two are the user's to retry; the last two are ours, and say so, so nobody goes
  off to reset a password that was never the problem.
#}

{% set pageTitle = heading + " - HMCTS API Marketplace - GOV.UK" %}
{% set section = "account" %}
{% set breadcrumbs = [{ text: "Home", href: "/" }] %}

{% block content %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <h1 class="govuk-heading-xl">{{ heading }}</h1>

      <p class="govuk-body" id="sign-in-problem">
        {%- if problem == "cancelled" %}{{ problemCancelled }}
        {%- elif problem == "expired" %}{{ problemExpired }}
        {%- elif problem == "rejected" %}{{ problemRejected }}
        {%- else %}{{ problemUnavailable }}{% endif -%}
      </p>

      {{ govukButton({ text: tryAgainButton, href: "/sign-in", attributes: { id: "sign-in-again" } }) }}

      <p class="govuk-body">{{ helpHtml | safe }}</p>

    </div>
  </div>

{% endblock %}