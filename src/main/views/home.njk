{% from "govuk/components/button/macro.njk" import govukButton %}

{% extends "template.njk" %}

{% set hideBackLink = true %}

{#
  Migrated from the GitHub Pages home page. The prototype rendered both prompts and let
  JavaScript hide one; here the session decides on the server, so the right prompt is there
  with JavaScript unavailable too.
#}

{% block content %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ heading }}</h1>
      <p class="govuk-body-l">{{ lede }}</p>

      {% if user %}
        <div class="govuk-button-group">
          {{ govukButton({ text: accountButton, href: "/account", attributes: { id: "home-account" } }) }}
        </div>
      {% else %}
        <div class="govuk-button-group">
          {{ govukButton({ text: signInButton, href: "/sign-in", attributes: { id: "home-sign-in" } }) }}
          {{ govukButton({
            text: registerButton,
            href: "/register",
            classes: "govuk-button--secondary",
            attributes: { id: "home-register" }
          }) }}
        </div>
      {% endif %}
    </div>
  </div>

  {% if user %}
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-two-thirds">
        <h2 class="govuk-heading-m">{{ signedInHeading }}</h2>
        <ul class="govuk-list">
          {% for link in signedInLinks %}
            <li><a class="govuk-link" href="{{ link.href }}">{{ link.text }}</a></li>
          {% endfor %}
        </ul>
      </div>
    </div>
    <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">
  {% endif %}

  {% for row in cardRows %}
    {% if not loop.first %}
      <hr class="govuk-section-break govuk-section-break--l govuk-section-break--visible">
    {% endif %}
    <div class="govuk-grid-row">
      {% for card in row %}
        <div class="govuk-grid-column-one-third">
          <h2 class="govuk-heading-m">
            <a class="govuk-link" href="{{ card.href }}">{{ card.heading }}</a>
          </h2>
          <p class="govuk-body">{{ card.body }}</p>
        </div>
      {% endfor %}
    </div>
  {% endfor %}

{% endblock %}
