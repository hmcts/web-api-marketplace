{% from "govuk/components/button/macro.njk" import govukButton %}

{% extends "template.njk" %}

{% set hideBackLink = true %}

{% block content %}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ heading }}</h1>
      <p class="govuk-body-l">{{ lede }}</p>

      {{ govukButton({
        text: startButton,
        href: "/subscribe",
        isStartButton: true,
        classes: "govuk-!-margin-top-2 govuk-!-margin-bottom-8"
      }) }}
    </div>
  </div>

  <div class="govuk-grid-row">
    {% for card in cards %}
      <div class="govuk-grid-column-one-third govuk-!-margin-bottom-6">
        <h2 class="govuk-heading-m">
          <a class="govuk-link" href="{{ card.href }}">{{ card.heading }}</a>
        </h2>
        <p class="govuk-body">{{ card.body }}</p>
      </div>
    {% endfor %}
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h2 class="govuk-heading-m">{{ backendCheck.heading }}</h2>
      <p class="govuk-body-m">{{ backendCheck.intro }}</p>

      {{ govukButton({
        text: backendCheck.buttonText,
        classes: "govuk-button--secondary",
        attributes: { id: "backend-check-button" }
      }) }}

      <div id="backend-check-result" role="status" aria-live="polite"></div>
    </div>
  </div>

{% endblock %}
