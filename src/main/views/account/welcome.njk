{% extends "template.njk" %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "macros/errors.njk" import errorSummary %}

{% set pageTitle = ("Error: " if errors.length) + "Welcome to the HMCTS API Marketplace - GOV.UK" %}
{% set section = "account" %}
{% set hideBackLink = true %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {{ errorSummary(errors) }}

    <h1 class="govuk-heading-xl">Welcome{% if profile.firstName %}, {{ profile.firstName }}{% endif %}</h1>

    <p class="govuk-body-l">Before you create an application, read how HMCTS APIs may be used.</p>

    <h2 class="govuk-heading-m">Your account</h2>

    {{ govukSummaryList({
      rows: [
        { key: { text: "Name" }, value: { text: profile.firstName + " " + profile.lastName } },
        { key: { text: "Email address" }, value: { text: profile.email } }
      ]
    }) }}

    <p class="govuk-body">These come from the account you signed in with. To change them, sign in and edit your profile there.</p>

    <form method="post" action="/account/welcome" novalidate>

      <h2 class="govuk-heading-m">Guidelines for using our APIs</h2>

      <ul class="govuk-list govuk-list--bullet">
        <li>Only request the APIs and data your service actually needs.</li>
        <li>Keep your client secret and subscription keys secret. Never put them in source code or share them.</li>
        <li>Test in the sandbox first. Production credentials are only issued after a review.</li>
        <li>Have a Data Sharing Agreement in place before you use any API that returns personal data.</li>
      </ul>

      <p class="govuk-body">
        Read the <a class="govuk-link" href="/documentation/consumer-guidance">consumer guidance</a> and the
        <a class="govuk-link" href="/get-started">getting started steps</a> for the detail.
      </p>

      {{ govukCheckboxes({
        name: "agree",
        fieldset: { legend: { text: "Agree to the guidelines", classes: "govuk-visually-hidden" } },
        items: [{ value: "yes", text: "I have read and agree to the guidelines for using HMCTS APIs" }],
        errorMessage: { text: errorFor.agree } if errorFor.agree
      }) }}

      {{ govukButton({ text: "Continue", attributes: { id: "welcome-continue" } }) }}
    </form>

  </div>
</div>
{% endblock %}