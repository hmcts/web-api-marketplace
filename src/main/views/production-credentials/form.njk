{% extends "template.njk" %}

{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/character-count/macro.njk" import govukCharacterCount %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "macros/errors.njk" import errorSummary %}

{% set pageTitle = ("Error: " if errors.length) + "Request production credentials - HMCTS API Marketplace - GOV.UK" %}
{% set section = "applications" %}
{% set breadcrumbs = [
  { text: "Home", href: "/" },
  { text: "Your account", href: "/account" },
  { text: "Manage applications", href: "/account/applications" }
] %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {{ errorSummary(errors) }}

    <h1 class="govuk-heading-xl">Request production credentials</h1>

    <p class="govuk-body">
      Production credentials let your application call our APIs with live data.
    </p>

    <p class="govuk-body">
      We will review your request to check that access is appropriate and whether any further approval or
      assurance is needed. Submitting this form does not give you access to the API or its data. We aim to tell
      you the outcome within 5 working days.
    </p>

    {% if not applicationItems.length %}
      <p class="govuk-body" id="no-applications">
        You need an application that has been tested in the sandbox first.
        <a class="govuk-link" href="/account/applications/new">Create an application</a>.
      </p>
    {% else %}

    <form method="post" action="/account/production-credentials" novalidate>

      {{ govukRadios({
        name: "application",
        fieldset: { legend: { text: "Which application is going live?", classes: "govuk-fieldset__legend--m" } },
        hint: { text: "Production credentials cover the same APIs as the application you choose." },
        items: applicationItems,
        value: answers.application,
        errorMessage: { text: errorFor.application } if errorFor.application
      }) }}

      {{ govukRadios({
        name: "organisation-type",
        idPrefix: "organisation-type",
        fieldset: { legend: { text: "Organisation", classes: "govuk-fieldset__legend--m" } },
        items: organisationTypeItems,
        errorMessage: { text: errorFor["organisation-type"] } if errorFor["organisation-type"]
      }) }}

      {{ govukInput({
        label: { text: "Team name (and organisation if external to HMCTS?)", classes: "govuk-label--m" },
        id: "organisation",
        name: "organisation",
        value: answers.organisation,
        autocomplete: "organization",
        errorMessage: { text: errorFor.organisation } if errorFor.organisation
      }) }}

      {{ govukDateInput({
        id: "go-live",
        namePrefix: "go-live",
        fieldset: { legend: { text: "When do you plan to go live?", classes: "govuk-fieldset__legend--m" } },
        hint: { text: "For example, 27 3 2027" },
        errorMessage: { text: errorFor["go-live-day"] } if errorFor["go-live-day"],
        items: [
          { id: "go-live-day", name: "day", label: "Day", classes: "govuk-input--width-2" + (" govuk-input--error" if errorFor["go-live-day"]), value: answers["go-live-day"] },
          { id: "go-live-month", name: "month", label: "Month", classes: "govuk-input--width-2" + (" govuk-input--error" if errorFor["go-live-day"]), value: answers["go-live-month"] },
          { id: "go-live-year", name: "year", label: "Year", classes: "govuk-input--width-4" + (" govuk-input--error" if errorFor["go-live-day"]), value: answers["go-live-year"] }
        ]
      }) }}

      {{ govukRadios({
        name: "call-volume",
        fieldset: { legend: { text: "Expected call volume in production", classes: "govuk-fieldset__legend--m" } },
        items: callVolumes,
        value: answers["call-volume"],
        errorMessage: { text: errorFor["call-volume"] } if errorFor["call-volume"]
      }) }}

      {{ govukCharacterCount({
        label: { text: "Why do you need access and how will you use the data?", classes: "govuk-label--m" },
        hint: { text: "For each API, briefly describe the business purpose, what you are trying to achieve and how the API data will be used" },
        id: "data-request",
        name: "data-request",
        maxlength: dataAnswerMaxLength,
        value: answers["data-request"],
        errorMessage: { text: errorFor["data-request"] } if errorFor["data-request"]
      }) }}

      {{ govukCheckboxes({
        name: "data-recipients",
        idPrefix: "data-recipients",
        fieldset: { legend: { text: "Who will have access to, or receive, the data?", classes: "govuk-fieldset__legend--m" } },
        hint: { text: "Select all that apply." },
        items: dataRecipientItems,
        errorMessage: { text: errorFor["data-recipients"] } if errorFor["data-recipients"]
      }) }}

      <div id="data-recipients-explanation-group">
        {{ govukCharacterCount({
          label: { text: "Briefly explain who will receive the data and why", classes: "govuk-label--s" },
          id: "data-recipients-explanation",
          name: "data-recipients-explanation",
          maxlength: dataAnswerMaxLength,
          value: answers["data-recipients-explanation"],
          errorMessage: { text: errorFor["data-recipients-explanation"] } if errorFor["data-recipients-explanation"]
        }) }}
      </div>

      {{ govukRadios({
        name: "data-combined",
        idPrefix: "data-combined",
        fieldset: { legend: { text: "Will you combine or link the API data with other data?", classes: "govuk-fieldset__legend--m" } },
        items: dataCombinedItems,
        errorMessage: { text: errorFor["data-combined"] } if errorFor["data-combined"]
      }) }}

      <div id="data-combined-description-group">
        {{ govukCharacterCount({
          label: { text: "Briefly describe the other data and what the combined data will be used for?", classes: "govuk-label--s" },
          id: "data-combined-description",
          name: "data-combined-description",
          maxlength: dataAnswerMaxLength,
          value: answers["data-combined-description"],
          errorMessage: { text: errorFor["data-combined-description"] } if errorFor["data-combined-description"]
        }) }}
      </div>

      {{ govukButton({ text: "Continue", attributes: { id: "production-continue" } }) }}
    </form>
    {% endif %}

  </div>
</div>
{% endblock %}
