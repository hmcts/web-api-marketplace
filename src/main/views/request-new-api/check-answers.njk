{% extends "template.njk" %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageTitle = "Check your answers - HMCTS API Marketplace - GOV.UK" %}
{% set section = "catalogue" %}
{% set breadcrumbs = [{ text: "Home", href: "/" }, { text: "Request a new API", href: "/api-catalogue/request-new-api" }] %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-xl">Check your answers before submitting</h1>

    {% set summaryRows = [] %}
    {% for row in rows %}
      {% set summaryRows = (summaryRows.push({ key: { text: row.key }, value: { text: row.value } }), summaryRows) %}
    {% endfor %}
    {{ govukSummaryList({ rows: summaryRows }) }}

    <form method="post" action="/api-catalogue/request-new-api/check-answers" novalidate>
      {{ govukButton({ text: "Accept and submit", attributes: { id: "new-api-submit" } }) }}
    </form>
    <p class="govuk-body"><a class="govuk-link" href="/api-catalogue/request-new-api">Change your answers</a></p>
  </div>
</div>
{% endblock %}
