{
  "name": "web-api-marketplace",
  "description": "Public Frontend for the Find a Court or Tribunal service",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.21.1"
  },
  "scripts": {
    "start": "NODE_ENV=production ts-node --transpile-only -r tsconfig-paths/register src/main/server.ts",
    "start:dev": "node ./scripts/dev-watcher.js",
    "lint": "stylelint **/*.scss -v -q && eslint . --ext .js,.ts && prettier --check .",
    "lint:fix": "prettier --write . .github && eslint --fix .",
    "build": "yarn webpack --config webpack.config.js",
    "build:prod": "NODE_ENV=production yarn webpack --mode production --config webpack.config.js",
    "test": "npx if-env CI=true && exit 0 || yarn test:unit",
    "test:unit": "jest",
    "test:coverage": "jest --coverage",
    "test:routes": "jest -c jest.routes.config.js",
    "test:smoke": "yarn playwright test --grep '@smoke'",
    "cichecks": "yarn install && yarn build && yarn lint && yarn test && yarn test:routes",
    "prepare": "husky install",
    "test:functional": "NODE_OPTIONS=--no-deprecation yarn playwright test --grep-invert='@smoke'",
    "test:functional:chrome": "yarn playwright test --project=chrome",
    "test:functional:edge": "yarn playwright test --project=edge",
    "test:functional:firefox": "yarn playwright test --project=firefox",
    "test:functional:webkit": "yarn playwright test --project=webkit",
    "test:performance": "yarn playwright test --grep='@performance'",
    "test:a11y": "echo 'a11y tests run as part of test:functional' && exit 0",
    "test:functional:headed": "playwright test --headed",
    "test:functional:ui": "playwright test --ui",
    "test:functional:debug": "playwright test --debug"
  },
  "dependencies": {
    "@azure/identity": "4.13.2",
    "@grpc/grpc-js": "^1.14.4",
    "@hmcts/cookie-manager": "1.1.0",
    "@hmcts/info-provider": "1.4.0",
    "@hmcts/nodejs-healthcheck": "1.8.6",
    "@hmcts/nodejs-logging": "4.0.4",
    "@hmcts/properties-volume": "1.4.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/lodash": "4.17.25",
    "@types/nunjucks": "3.2.6",
    "@types/require-directory": "2.1.7",
    "applicationinsights": "3.16.0",
    "async-mutex": "0.5.0",
    "awilix": "13.0.5",
    "awilix-express": "11.0.1",
    "axios": "1.19.0",
    "config": "4.4.2",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "glob": "13.0.6",
    "govuk-frontend": "5.14.0",
    "helmet": "8.3.0",
    "i18next": "26.4.0",
    "i18next-http-middleware": "3.9.8",
    "lodash": "4.18.1",
    "luxon": "3.7.2",
    "nunjucks": "3.2.4",
    "stylelint": "17.14.1",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "7.29.7",
    "@babel/plugin-proposal-decorators": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/compat": "2.1.0",
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "10.0.1",
    "@hmcts/playwright-common": "^1.1.2",
    "@playwright/test": "1.61.1",
    "@types/babel__preset-env": "7.10.0",
    "@types/chai": "5.2.3",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.1",
    "@types/sinon": "21.0.1",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "babel-jest": "30.4.1",
    "babel-loader": "10.1.1",
    "chai": "6.2.2",
    "chokidar": "5.0.0",
    "copy-webpack-plugin": "14.0.0",
    "css-loader": "7.1.4",
    "dotenv": "^17.4.2",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.16.1",
    "eslint-plugin-playwright": "2.11.0",
    "get-port": "^7.2.0",
    "globals": "17.11.0",
    "html-webpack-plugin": "5.6.8",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-html-reporter": "4.4.0",
    "lighthouse": "13.4.1",
    "lint-staged": "17.1.1",
    "mini-css-extract-plugin": "2.10.2",
    "odhin-reports-playwright": "1.1.8",
    "playwright": "1.61.1",
    "playwright-core": "1.61.1",
    "playwright-lighthouse": "^4.0.0",
    "prettier": "3.9.6",
    "sass": "1.102.0",
    "sass-loader": "16.0.8",
    "sinon": "22.0.0",
    "style-loader": "4.0.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-loader": "9.6.2",
    "webpack": "5.108.4",
    "webpack-cli": "7.2.2",
    "webpack-dev-middleware": "8.1.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown",
    "**/*.{js,ts}": "eslint --fix"
  },
  "resolutions": {
    "@grpc/grpc-js": "^1.14.4",
    "@opentelemetry/core": "npm:@opentelemetry/core@2.9.0",
    "body-parser@npm:^2.2.1": "npm:2.3.0",
    "brace-expansion@npm:^1.1.7": "npm:brace-expansion@1.1.18",
    "brace-expansion@npm:^2.0.2": "npm:brace-expansion@2.1.4",
    "brace-expansion@npm:^5.0.2": "npm:5.0.9",
    "brace-expansion@npm:^5.0.5": "npm:5.0.9",
    "form-data": "4.0.6",
    "joi": "18.2.5",
    "ip-address": "10.7.0",
    "js-yaml": "4.3.1",
    "protobufjs": "7.6.5",
    "uuid": "14.0.2",
    "fast-uri": "3.1.5",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "@opentelemetry/propagator-jaeger": "2.9.0"
  },
  "packageManager": "yarn@4.17.1"
}
