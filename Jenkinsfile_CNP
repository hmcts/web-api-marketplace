#!groovy

@Library("Infrastructure@2.13.6")

def type = "nodejs"
def product = "amp"
def component = "marketplace-web"

def yarnBuilder = new uk.gov.hmcts.contino.YarnBuilder(this)

static Map<String, Object> secret(String secretName, String envVariable) {
  [
    $class     : 'AzureKeyVaultSecret',
    secretType : 'Secret',
    name       : secretName,
    envVariable: envVariable
  ]
}

// The AAT functional tests sign in as real Entra test accounts. They and their passwords are
// managed by hmcts/external-entra-id (tenants/stg/config/users.yaml); jenkins-aat-mi may read
// these two secrets and nothing else in the vault.
def loadAatTestAccounts() {
  env.AMP_TEST_USER_EMAIL = 'amp-functional-user@hmctsextstg.onmicrosoft.com'
  env.AMP_TEST_ADMIN_EMAIL = 'amp-functional-admin@hmctsextstg.onmicrosoft.com'
  azureKeyVault(
    keyVaultURL: 'https://kvspsextidaat.vault.azure.net/',
    secrets: [
      secret('entra-amp-user-amp-functional-user-at-hmctsextstg-onmicrosoft-com', 'AMP_TEST_USER_PASSWORD'),
      secret('entra-amp-user-amp-functional-admin-at-hmctsextstg-onmicrosoft-com', 'AMP_TEST_ADMIN_PASSWORD'),
    ]
  ) {
    env.AMP_TEST_USER_PASSWORD = "${AMP_TEST_USER_PASSWORD}"
    env.AMP_TEST_ADMIN_PASSWORD = "${AMP_TEST_ADMIN_PASSWORD}"
  }
}

withPipeline(type, product, component) {
  env.PLAYWRIGHT_WORKERS = 4
  env.PLAYWRIGHT_REPORTERS = 'list,odhin'
  env.PLAYWRIGHT_VIDEO_MODE = 'retain-on-failure'

  onPR() {
    env.ENV = 'preview'
  }

  afterSuccess('akschartsinstall') {
    yarnBuilder.yarn('build')
  }

  before('smoketest:preview') {
    yarnBuilder.yarn('playwright install')
  }

  before('smoketest:aat') {
    yarnBuilder.yarn('playwright install')
  }

  before('functionalTest:preview') {
    yarnBuilder.yarn('playwright install')
  }

  before('functionalTest:aat') {
    yarnBuilder.yarn('playwright install')
    loadAatTestAccounts()
  }

  afterAlways('functionalTest:preview') {
    publishHTML target: [
      allowMissing          : true,
      alwaysLinkToLastBuild : true,
      keepAll               : true,
      reportDir             : 'test-results',
      reportFiles           : 'odhin-report/index.html,lighthouse-report-*.html',
      reportName            : 'Functional Test Report',
    ]
  }

  afterAlways('functionalTest:aat') {
    publishHTML target: [
      allowMissing          : true,
      alwaysLinkToLastBuild : true,
      keepAll               : true,
      reportDir             : 'test-results',
      reportFiles           : 'odhin-report/index.html,lighthouse-report-*.html',
      reportName            : 'Functional Test Report',
    ]
  }

  afterAlways('smoketest:preview') {
    publishHTML target: [
      allowMissing          : true,
      alwaysLinkToLastBuild : true,
      keepAll               : true,
      reportDir             : 'test-results',
      reportFiles           : 'odhin-report/index.html',
      reportName            : 'Smoke Test Report',
    ]
  }

  afterAlways('smoketest:aat') {
    publishHTML target: [
      allowMissing          : true,
      alwaysLinkToLastBuild : true,
      keepAll               : true,
      reportDir             : 'test-results',
      reportFiles           : 'odhin-report/index.html',
      reportName            : 'Smoke Test Report',
    ]
  }
}
